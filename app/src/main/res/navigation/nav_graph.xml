<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.fullcheck.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

        <action
            android:id="@+id/action_FirstFragment_to_NativeCheckListFragment"
            app:destination="@id/NativeCheckListFragment" />

        <action
            android:id="@+id/action_FirstFragment_to_SystemInfoFragment"
            app:destination="@id/SystemInfoFragment" />
    </fragment>

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.fullcheck.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <fragment
        android:id="@+id/NativeCheckListFragment"
        android:name="com.example.fullcheck.NativeCheckListFragment"
        android:label="@string/native_check_list_label"
        tools:layout="@layout/fragment_native_check_list">

        <action
            android:id="@+id/action_NativeCheckListFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <fragment
        android:id="@+id/SystemInfoFragment"
        android:name="com.example.fullcheck.SystemInfoFragment"
        android:label="@string/system_info_label"
        tools:layout="@layout/fragment_system_info">

        <action
            android:id="@+id/action_SystemInfoFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
</navigation>
